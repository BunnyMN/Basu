{
  "name": "basu",
  "version": "0.1.0",
  "description": "Dine-in pre-order — fire timing engine",
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/web && cp -R src/web/. dist/web/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:reset": "tsx src/db/migrate.ts --reset",
    "sim": "tsx src/sim/run.ts",
    "api": "tsx watch src/entry/api.ts",
    "scheduler": "tsx watch src/entry/scheduler.ts",
    "seed": "tsx src/seed/demo.ts",
    "dev": "npm run db:migrate && npm run seed && npm run api",
    "smoke": "tsx src/test/smoke.ts",
    "verify": "node scripts/verify.mjs",
    "start": "node dist/entry/api.js",
    "start:scheduler": "node dist/entry/scheduler.js",
    "db:migrate:dist": "node dist/db/migrate.js",
    "seed:dist": "node dist/seed/demo.js",
    "ios": "node scripts/ios.mjs",
    "ios:test": "node scripts/ios.mjs test",
    "inspect": "node scripts/inspect.mjs",
    "probe:route": "node scripts/probe-route.mjs",
    "ios:pass": "node scripts/ios-pass.mjs"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.5",
    "jsdom": "^29.1.1",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^25.9.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "fastify": "^5.12.1",
    "pg": "^8.23.0"
  }
}
