# Local development. Copy to .env
DATABASE_URL=postgres://bunny@localhost:5432/basu_dev
NODE_ENV=development
# Scheduler
SCHEDULER_TICK_MS=1000
SCHEDULER_BATCH=50
SCHEDULER_SPACING_MS=250
# Ops: the shared secret the /ops page sends. Required in production; demo
# mode mints one at boot and hands it out at /dev/ops-token.
OPS_TOKEN=
