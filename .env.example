# Local development. Copy to .env
DATABASE_URL=postgres://bunny@localhost:5432/basu_dev
NODE_ENV=development
# Scheduler
SCHEDULER_TICK_MS=1000
SCHEDULER_BATCH=50
SCHEDULER_SPACING_MS=250
# Ops: who may sit at the desk, by the phone they sign in with. Comma-separated
# phone:name:role, roles admin | finance | ops | viewer. Synced at boot.
OPS_MEMBERS=+97688102856:Баярцогт:admin
# The demo's shared secret for walkthroughs, minted at boot when unset and
# handed out at /dev/ops-token. Ignored in production: members only.
OPS_TOKEN=
# Payments: Wire (wire.mn) fronts QPay. Without the secret key the payment
# provider stays the fake, which says every top-up succeeded — never run a
# real server that way. sk_test_… pays through Wire's sandbox and moves no
# money; sk_live_… is real. Server side only: never in the app, never here.
WIRE_SECRET_KEY=
# Only needed to accept callbacks. Register the endpoint once
# (POST /v1/webhook_endpoints, enabled_events ["payment_intent.succeeded"],
# url https://<host>/v1/payments/wire/webhook) and keep the whsec_… it
# answers with — Wire shows it once. Allow 65.109.117.186 through the
# firewall. Without it the app still fills wallets by asking Wire directly.
WIRE_WEBHOOK_SECRET=
# Where the hosted checkout sends the person back to.
WIRE_RETURN_URL=https://basu.burzai.cloud/

# Bank account numbers are encrypted at rest with this key, 32 bytes base64
# (openssl rand -base64 32). Production refuses to store one without it.
# Keep it somewhere the database backup is not.
BANK_KEY=

# Apple Push (APNs): device notifications and Live Activity updates. All three
# of team, key id and key must be set or the push provider stays the fake.
# The key is the .p8 from developer.apple.com → Keys (APNs enabled), never
# committed: a path, or the PEM inline with \n for newlines.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_KEY_FILE=/opt/basu/apns.p8
# APNS_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
APNS_BUNDLE_ID=mn.basu.app
# sandbox for development builds (Xcode, TestFlight uses production), production for the store
APNS_ENV=sandbox

# Email: sign-in codes, and messages for anybody without the app. Any SMTP
# server works — a Gmail account with an app password, Resend, Brevo, Amazon
# SES. Characters in the user or password that mean something in a URL
# (@ : / %) are percent-encoded. Unset: production has no email door, and
# anywhere else the letters are printed to the console instead.
SMTP_URL=
# SMTP_URL=smtps://you%40gmail.com:app-password@smtp.gmail.com:465
MAIL_FROM=
# MAIL_FROM="Basu <you@gmail.com>"

# Sign in with Google: console.cloud.google.com → APIs & Services →
# Credentials → OAuth client ID → Web application, with the authorised
# redirect URI <PUBLIC_ORIGIN>/v1/auth/google/callback. Either unset: no
# Google button anywhere. The secret is the server's alone.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Where this server is reached from outside; Google sends people back here.
# Defaults to https://basu.burzai.cloud. Locally: http://localhost:3000, with
# that callback added to the OAuth client too.
# PUBLIC_ORIGIN=http://localhost:3000
# Sign in with Apple (the iPhone app): the bundle ids a token may be for.
APPLE_BUNDLE_IDS=mn.basu.app
