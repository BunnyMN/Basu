# Local development. Copy to .env
DATABASE_URL=postgres://bunny@localhost:5432/basu_dev
NODE_ENV=development
# Scheduler
SCHEDULER_TICK_MS=1000
SCHEDULER_BATCH=50
SCHEDULER_SPACING_MS=250
# Ops: the shared secret the /ops page sends. Required in production; demo
# mode mints one at boot and hands it out at /dev/ops-token.
OPS_TOKEN=
# Apple Push (APNs): device notifications and Live Activity updates. All three
# of team, key id and key must be set or the push provider stays the fake.
# The key is the .p8 from developer.apple.com → Keys (APNs enabled), never
# committed: a path, or the PEM inline with \n for newlines.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_KEY_FILE=/opt/basu/apns.p8
# APNS_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
APNS_BUNDLE_ID=mn.basu.app
# sandbox for development builds (Xcode, TestFlight uses production), production for the store
APNS_ENV=sandbox
